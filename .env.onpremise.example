# =====================================================
# OptiCRM On-Premise — Configuration
# Copiez ce fichier en .env et remplissez les valeurs
# =====================================================

# Version de l'application (ex: 1.0.0)
OPTICRM_VERSION=latest

# ── Base de données SQL Server ────────────────────────
# Mot de passe fort requis (min. 8 car., maj., min., chiffres, spéciaux)
DB_SA_PASSWORD=YourStrongPassword@2024!

# ── Redis ─────────────────────────────────────────────
REDIS_PASSWORD=YourRedisPassword@2024!

# ── JWT Secret (générer avec: openssl rand -base64 64) ──
JWT_SECRET=CHANGEZ_CETTE_CLE_JWT_SUPER_SECRETE_MINIMUM_64_CARACTERES_ALEATOIRES

# ── Clé de licence (fournie par OptiCRM) ──────────────
# Laissez vide pour le mode communautaire (fonctionnalités de base)
LICENSE_KEY=

# ── Port d'écoute web ──────────────────────────────────
HTTP_PORT=80

# ── IA Anthropic (requis pour module SAV) ─────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (embeddings vectoriels KB — text-embedding-3-small) ──
OPENAI_API_KEY=sk-...

# ── Module SAV IA ─────────────────────────────────────
SAV_KAMAL_WHATSAPP=+212600000000
SAV_OTP_EXPIRATION_MINUTES=10
SAV_SESSION_EXPIRATION_HOURS=8
SAV_RAPPORT_QUOTIDIEN_HEURE=19
SAV_RAPPORT_QUOTIDIEN_MINUTE=0

# ── Embedding SAV ─────────────────────────────────────
SAV_EMBEDDING_MODEL=text-embedding-3-small
SAV_EMBEDDING_DIMENSION=1536
SAV_EMBEDDING_SEUIL_P1=0.80
SAV_EMBEDDING_SEUIL_P2=0.75
SAV_EMBEDDING_SEUIL_P3=0.70

# ── WhatsApp Business API (Phase 2) ───────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=kasoft-sav-verify-token
