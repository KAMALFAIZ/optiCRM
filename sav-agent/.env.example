# =============================================================================
# SAV Agent - Variables d'environnement
# =============================================================================
# Copier ce fichier en .env et configurer les valeurs
# =============================================================================

# OBLIGATOIRE
AGENT_API_KEY=votre_cle_api_ici
AGENT_CENTRAL_URL=wss://crm.votredomaine.com/ws/agent
AGENT_NAME=SAV-Agent-01

# Base de données locale (optionnel)
LOCAL_DB_ENABLED=false
LOCAL_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=erp_local;encrypt=false
LOCAL_DB_USER=readonly_user
LOCAL_DB_PASSWORD=

# HTTP local
LOCAL_HTTP_ENABLED=true
LOCAL_HTTP_BASE_URL=http://localhost:8090

# Shell (désactivé par défaut)
SHELL_ENABLED=false

# Port health check
AGENT_MGMT_PORT=9091
